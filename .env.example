# ─────────────────────────────────────────────────────────────
# SaludTech — Environment Variables (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# Backend port (default 8081)
PORT=8081

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/saludtech?sslmode=disable

# JWT secret (min 32 chars, use a random string in production)
SALUDTECH_JWT_SECRET=change-me-to-a-very-long-random-string-at-least-256-bits

# QR token signing secret
SALUDTECH_QR_SECRET=change-me-to-another-long-random-string

# CORS — comma-separated list of allowed origins
# Must include all frontend URLs (Vercel + localhost) for cookies to work
CORS_ALLOWED_ORIGINS=https://salud-tech-cashea-medico-web-patien.vercel.app,https://web-admin-mu-two.vercel.app,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# DolarVZLA API key (BCV CDN is free; USDT endpoints need a key)
# Get yours at https://dolarvzla.com
DOLARVZLA_KEY=your-dolarvzla-api-key-here

# FakePay test payment gateway
# Get yours at https://fakepayment.onrender.com
FAKEPAY_API_KEY=your-fakepay-api-key-here

# ─── Frontend apps ───────────────────────────────────────────
# Each app needs its own .env.local (or Vercel env vars) with:
#   NEXT_PUBLIC_API_URL=https://saludtech-casheamedico.onrender.com/api/v1
#   JWT_SECRET=<same value as SALUDTECH_JWT_SECRET above>
